# Gemma 4 is the only model. Local Ollama by default (no key needed, "ollama" is a dummy).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b
# If your laptop is too slow, use hosted Gemma 4 instead:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemma-4-31b-it:free

# Optional web check (sends only extracted link/phone/brand text, never the image)
ENABLE_WEB_CHECK=false
TAVILY_API_KEY=
# Optional: Google Safe Browsing (enable the API in Google Cloud). Sends only extracted link text.
SAFE_BROWSING_API_KEY=
# Optional: run the verify step through the OpenAI Agents SDK (falls back to direct tools)
USE_AGENT_VERIFY=false

# Optional: enables POST /api/listen, the webhook for a phone automation app (Tasker, MacroDroid, Shortcuts).
# Send this value in the X-Listen-Token header. Leave empty to keep the endpoint off.
LISTEN_TOKEN=

FRONTEND_ORIGIN=http://localhost:3000
